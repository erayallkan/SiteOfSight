{
  "expo": {
    "name": "SiteOfSight",
    "slug": "SiteOfSight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "siteofsight",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siteofsight.app",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "IFC Model",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": ["com.siteofsight.ifc"]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.siteofsight.ifc",
            "UTTypeDescription": "Industry Foundation Classes Model",
            "UTTypeConformsTo": ["public.data", "public.content"],
            "UTTypeTagSpecification": { "public.filename-extension": ["ifc"] }
          }
        ]
      }
    },
    "android": {
      "package": "com.siteofsight.app",
      "adaptiveIcon": {
        "backgroundColor": "#021944",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "content", "mimeType": "*/*", "pathPattern": ".*\\.ifc" },
            { "scheme": "file", "mimeType": "*/*", "pathPattern": ".*\\.ifc" }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-sqlite",
      "expo-document-picker",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6F9",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E1116"
          }
        }
      ]
    ]
  }
}
