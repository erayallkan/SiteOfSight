{
  "name": "siteofsight",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "setup": "expo install @expo/vector-icons expo-asset expo-file-system expo-sqlite expo-document-picker expo-localization expo-splash-screen react-native-webview react-native-screens react-native-safe-area-context react-native-gesture-handler @react-native-async-storage/async-storage",
    "vendor": "node scripts/fetch-vendor.mjs",
    "bootstrap": "npm install && npm run setup && npm run vendor && npm run sample && npm run build:viewer",
    "sample": "node scripts/make-sample-ifc.mjs",
    "build:viewer": "node scripts/build-viewer.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  }
}
